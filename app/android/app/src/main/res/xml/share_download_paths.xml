<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides react-native-share's FileProvider paths: its two entries plus files/traces for trace CSVs. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="rnshare1" path="Download/" />
    <cache-path name="rnshare2" path="/" />
    <files-path name="traces" path="traces/" />
</paths>

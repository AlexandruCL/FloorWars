{
  "name": "FloorWars",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "cd .. && husky app/.husky"
  },
  "dependencies": {
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-share": "12.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "8.57.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "17.6.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  },
  "codegenConfig": {
    "name": "FloorWarsSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.floorwars.floorsensors"
    }
  }
}

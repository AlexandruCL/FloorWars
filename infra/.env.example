# Copy to infra/.env on the VM and fill in. Non-secret values only: secrets live in
# infra/secrets/*.enc.* (SOPS) and reach containers as files, never through this file.
# API_TAG is set by deploy.sh (the git sha); do not put it here on the VM.

# Public hostname served by Caddy (A record -> VM IP), e.g. api.example.com
DOMAIN=<DOMAIN>
# Contact address for Let's Encrypt expiry notices
ACME_EMAIL=<ACME_EMAIL>

FLOORWARS_ENV=prod
FLOORWARS_LOG_LEVEL=INFO

# E-mail sign-in codes through Azure Communication Services (acs_access_key is a SOPS secret).
FLOORWARS_MAIL_BACKEND=acs
FLOORWARS_ACS_ENDPOINT=https://<ACS_RESOURCE>.communication.azure.com
FLOORWARS_MAIL_FROM=DoNotReply@<ACS_EMAIL_DOMAIN>
FLOORWARS_ALLOWED_EMAIL_DOMAINS=student.upt.ro

# Defaults shown; change only if the layout differs (docs/runbook.md).
# API_IMAGE=ghcr.io/alexandrucl/floorwars-api
# DATA_DIR=/srv/floorwars/data
# SECRETS_DIR=/run/secrets/floorwars

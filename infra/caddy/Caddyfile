# FloorWars reverse proxy (plan 7.4). DOMAIN and ACME_EMAIL come from the compose environment.
# Production: DOMAIN=api.<domain> -> automatic HTTPS with Let's Encrypt.
# Local (compose.local.yml): DOMAIN=:80 -> plain HTTP, no certificates.
{
	email {$ACME_EMAIL}
	# Caddy's admin API stays on localhost inside the container (used by `caddy reload`).

	# The default logger also carries the request URI (for example the error entry of a 502 when
	# every api replica is down): drop the socket's access_token there too, as in the site log.
	log default {
		output stderr
		format filter {
			request>uri query {
				delete access_token
			}
			wrap json
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
		-Via
	}
}

{$DOMAIN} {
	import security_headers
	encode zstd gzip

	# /metrics is scraped by Prometheus on the internal network (Week 5), never public.
	@internal path /metrics /metrics/*
	respond @internal 404

	# TODO (Week 5, plan 7.4/7.11): per-IP request limits. Needs a Caddy build with the
	# rate_limit plugin (github.com/mholt/caddy-ratelimit) via xcaddy; the stock caddy:2
	# image has no rate limiter. Per-user limits are a Valkey token bucket in the API.

	# FastAPI buffers the whole body before it checks the token, and the app has no size limit
	# of its own, so the cap lives here. 1MB is 1,000,000 bytes. Over it: 413 from this proxy.
	request_body {
		max_size 1MB
	}

	reverse_proxy {
		# `dynamic a` resolves every api replica (Docker DNS returns one A record per
		# container), so round robin applies per replica, and scaling or recreating replicas
		# needs no Caddy reload.
		dynamic a {
			name api
			port 8000
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms

		# These do NOT run: Caddy skips active health checks for dynamic upstreams (tested on
		# 2.11.7, a replica failing /healthz kept its share of traffic). They take effect only
		# if the upstreams become static.
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
		health_status 2xx

		# No passive checks (fail_duration): Caddy counts a body over request_body's limit as a
		# failure of the replica, so two anonymous oversized POSTs took both replicas out for
		# 30 s (503 for everyone, tested on 2.11.7). Do not add them back without retesting.
		# So no replica is ever ejected. A refused connection is still retried on the next
		# replica (no failed requests in tests); a replica that hangs or answers 5xx keeps its
		# share of traffic.
	}

	log {
		output stdout
		# The socket's access_token query value (WS /v1/ws) never reaches the log. Caddy
		# already redacts the Authorization header. Caddy proxies the WebSocket upgrade
		# natively and has no idle timeout on an upgraded connection.
		format filter {
			request>uri query {
				delete access_token
			}
			wrap json
		}
	}
}

# Later (Week 5): admin panel, team IPs only (plan 7.1). The Grafana site is below.
# {$ADMIN_DOMAIN} {
# 	import security_headers
# 	@team remote_ip <TEAM_IP_1>/32 <TEAM_IP_2>/32
# 	handle @team {
# 		reverse_proxy admin:8000
# 	}
# 	respond 403
# }
#
# Grafana (W5-6): team IPs only, then basic auth (hash in a secret file), then Grafana's own
# login. GRAFANA_DOMAIN unset: the .localhost fallback is served with Caddy's internal CA only.
# TEAM_IPS is a space-separated list of CIDRs from infra/.env.
{$GRAFANA_DOMAIN:grafana.localhost} {
	# Not the security_headers snippet: its CSP (default-src 'none') would blank Grafana's UI.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
		-Via
	}
	@team remote_ip {$TEAM_IPS:127.0.0.1/32}
	handle @team {
		basic_auth {
			team {file./run/secrets/grafana_basic_hash}
		}
		# Grafana would read the basic-auth header as its own credentials.
		reverse_proxy grafana:3000 {
			header_up -Authorization
		}
	}
	respond 403
}

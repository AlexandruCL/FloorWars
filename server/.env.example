# Example settings for local development. Dummy values only; never commit real secrets.
# In staging/prod, secrets come from /run/secrets (SOPS, plan section 7.5), not from env files.
FLOORWARS_ENV=dev
FLOORWARS_LOG_LEVEL=INFO
FLOORWARS_DATABASE_URL=postgresql+psycopg://floorwars:change-me@localhost:5432/floorwars
FLOORWARS_VALKEY_URL=redis://localhost:6379/0

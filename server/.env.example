# Example settings for local development. Dummy values only; never commit real secrets.
# In staging/prod, secrets come from /run/secrets/floorwars_<name> (SOPS, plan section 7.5),
# not from env files. Every variable is described in server/README.md ("Configuration").
FLOORWARS_ENV=dev
FLOORWARS_LOG_LEVEL=INFO
FLOORWARS_DATABASE_URL=postgresql+psycopg://floorwars:change-me@localhost:5432/floorwars
FLOORWARS_VALKEY_URL=redis://localhost:6379/0

# Sign-in (plan 7.9)
FLOORWARS_ALLOWED_EMAIL_DOMAINS=student.upt.ro
FLOORWARS_OTP_TTL_S=600
FLOORWARS_OTP_MAX_ATTEMPTS=5
FLOORWARS_OTP_RATE_PER_EMAIL_PER_HOUR=5
FLOORWARS_OTP_RATE_PER_IP_PER_HOUR=60
FLOORWARS_VERIFY_RATE_PER_IP_PER_HOUR=300
FLOORWARS_REFRESH_RATE_PER_IP_PER_HOUR=1200

# Sign-in e-mail: log (dev, logs the address, never the code), fake (tests), acs (production)
FLOORWARS_MAIL_BACKEND=log
# Needed only with FLOORWARS_MAIL_BACKEND=acs (required in prod). The access key is a secret.
# FLOORWARS_MAIL_FROM=DoNotReply@00000000-0000-0000-0000-000000000000.azurecomm.net
# FLOORWARS_ACS_ENDPOINT=https://example.communication.azure.com
# FLOORWARS_ACS_ACCESS_KEY=<base64 access key, secret>

# Tokens. The signing key is the hex of a 32-byte Ed25519 seed (64 hex characters, secret).
# Unset in dev: a random key per process (tokens stop working after a restart).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# FLOORWARS_JWT_SIGNING_KEY=<64 hex characters, secret>
FLOORWARS_JWT_AUDIENCE=floorwars-api
FLOORWARS_ACCESS_TOKEN_TTL_S=900
FLOORWARS_REFRESH_TOKEN_TTL_S=2592000

# Entrance QR signatures (HMAC-SHA256), 64 hex characters, secret. Used by the check-in feature.
# FLOORWARS_QR_HMAC_KEY=<64 hex characters, secret>
